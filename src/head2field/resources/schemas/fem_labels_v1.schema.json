{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:head2field:schema:fem-labels:v1",
  "title": "FEM labels v1 manifest",
  "description": "Runtime-validated manifest for the complete 75 source-to-Oz label export.",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "profile_id",
    "query_count",
    "reference_electrode",
    "reference_mode",
    "electrode_count",
    "source_count",
    "source_names",
    "vector_frame",
    "component_order",
    "label_axis_order",
    "output_dtype",
    "output_unit",
    "source_current_mA",
    "reference_current_mA",
    "conductivity_table",
    "interpolation",
    "leadfield_provenance",
    "labels",
    "publication"
  ],
  "properties": {
    "schema_id": {
      "const": "fem_labels_v1"
