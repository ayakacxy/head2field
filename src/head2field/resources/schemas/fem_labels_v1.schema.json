        "solver_values_s_per_m": {
          "const": [
            0.126,
            0.275,
            1.654,
            0.01,
            0.465,
            0.5,
            0.008,
            0.025,
            0.6,
            0.16
          ]
        },
        "project_table": {
          "$ref": "#/$defs/conductivity_table"
        }
      },
      "additionalProperties": false
    },
    "solver_conductivity": {
      "type": "object",
      "required": [
        "schema_id",
        "configured_runtime_object",
        "matlab_readback",
        "verification"
      ],
      "properties": {
        "schema_id": {
          "const": "solver_conductivity_verification_v1"
        },
        "configured_runtime_object": {
          "allOf": [
            {
              "$ref": "#/$defs/solver_snapshot"
            },
            {
              "properties": {
                "runtime_source": {
                  "const": "simnibs.TDCSLEADFIELD.cond_before_run"
                }
              }
            }
          ]
        },
        "matlab_readback": {
          "allOf": [
            {
              "$ref": "#/$defs/solver_snapshot"
            },
            {
              "properties": {
                "runtime_source": {
                  "const": "simnibs_simulation_mat_readback"
                }
              }
            }
          ]
        },
        "verification": {
          "const": "exact_match"
        }
      },
      "additionalProperties": false
    },
